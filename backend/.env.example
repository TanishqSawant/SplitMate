# Database
DATABASE_URL=postgresql://splitmate_user:your_password_here@localhost:5432/splitmate_db

# Application
APP_ENV=development
DEBUG=true

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Internal service authentication
# Pawan's AI extraction service must send this value in the X-Internal-Service-Key header.
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_SECRET=your_internal_service_secret_here

# JWT Authentication
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PayPal Sandbox (Tanay will configure)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=10.0

# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

