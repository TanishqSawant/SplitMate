# Database
DATABASE_URL=postgresql://splitmate_user:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/splitmate_db
# Or for local development without PostgreSQL:
# DATABASE_URL=sqlite:///./splitmate.db

# Application
APP_ENV=development
DEBUG=true

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Internal service authentication
# Pawan's AI extraction service must send this value in the X-Internal-Service-Key header.
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_SECRET=CHANGE_ME_INTERNAL_SERVICE_SECRET

# JWT Authentication
# Generate a strong 256-bit secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY

# PayPal Sandbox (Tanay will configure)
PAYPAL_CLIENT_ID=CHANGE_ME_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=CHANGE_ME_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_TIMEOUT_SECONDS=10
