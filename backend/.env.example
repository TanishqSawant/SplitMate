# Database
DATABASE_URL=postgresql://splitmate_user:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/splitmate_db
# Or for local development without PostgreSQL:
# DATABASE_URL=sqlite:///./splitmate.db

# Application
APP_ENV=development
DEBUG=true

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
