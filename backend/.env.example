# =============================================================================
# SplitMate Backend Environment Configuration Template
# =============================================================================
# For production (Render), configure these in your Render Dashboard > Environment.

# 1. Database (PostgreSQL 15+ / Neon Serverless)
# Example: postgresql://username:password@ep-host.neon.tech/splitmate?sslmode=require
DATABASE_URL=postgresql://splitmate_user:your_password_here@localhost:5432/splitmate_db
# Or for local offline development without PostgreSQL:
# DATABASE_URL=sqlite:///./splitmate.db

# 2. Application Mode
APP_ENV=development
DEBUG=false

# 3. CORS & Networking
# Comma-separated list of allowed origins. In production, add your Vercel domain.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://splitmate.vercel.app

# 4. Authentication (Stateless JWT)
# Generate a strong 256-bit random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. Internal Service Authentication (AI Extractor webhook secret)
INTERNAL_SERVICE_SECRET=your_internal_service_secret_here

# 6. Google Gemini AI Vision (Multimodal receipt extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 7. Cloudflare R2 Persistent Object Storage (Receipt scans)
# Leave empty to use local filesystem uploads/ directory during local development
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=splitmate-receipts
R2_PUBLIC_DOMAIN=

# 8. Local File Upload Limits (used if R2 is not configured)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# 9. PayPal Sandbox Integration
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_MOCK_MODE=false
