# SplitMate Frontend Environment Configuration Template
# For local development: http://127.0.0.1:8000/api
# For production (Vercel): https://splitmate-api.onrender.com/api
VITE_API_BASE_URL=http://localhost:8000/api

# Disable mock fallback in production to surface honest network status (true in dev, false in prod)
VITE_ENABLE_MOCK_FALLBACK=true

# Force mock mode for offline testing
VITE_USE_MOCK_API=false

# PayPal Sandbox Client ID ("sb" for standard sandbox testing, or your custom sandbox client ID)
VITE_PAYPAL_CLIENT_ID=sb

# AI Receipt Extraction Configuration
VITE_AI_RECEIPT_ENDPOINT=/receipts/extract
VITE_AI_CONFIDENCE_THRESHOLD=0.85
